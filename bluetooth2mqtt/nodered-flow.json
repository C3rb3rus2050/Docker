[
  {
    "id": "b2m_tab",
    "type": "tab",
    "label": "Heizung (bluetooth2mqtt)",
    "disabled": false,
    "info": "Steuert und liest die Comet-Blue-Thermostate über bluetooth2mqtt.\n\nSetzen: Topic bluetooth2mqtt/<name>/set, Payload = Zahl (Solltemperatur) oder JSON, z. B. {\"comfort_temperature\":21,\"eco_temperature\":17}\nEinzelwert: bluetooth2mqtt/<name>/set/<feld>\nAuslesen: bluetooth2mqtt/<name>/get\nWerte stehen im Flow-Kontext unter heizung.<name>."
  },
  {
    "id": "b2m_broker",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "b2m_comment_read",
    "type": "comment",
    "z": "b2m_tab",
    "name": "Werte auslesen",
    "info": "",
    "x": 120,
    "y": 40,
    "wires": []
  },
  {
    "id": "b2m_in_state",
    "type": "mqtt in",
    "z": "b2m_tab",
    "name": "Zustand aller Geräte",
    "topic": "bluetooth2mqtt/+",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "b2m_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 100,
    "wires": [["b2m_fn_state"]]
  },
  {
    "id": "b2m_fn_state",
    "type": "function",
    "z": "b2m_tab",
    "name": "Werte speichern",
    "func": "// leere Nachrichten entstehen beim Entfernen/Umbenennen eines Geräts\nconst name = msg.topic.split('/')[1];\nconst all = flow.get('heizung') || {};\nif (typeof msg.payload !== 'object' || msg.payload === null) {\n    delete all[name];\n    flow.set('heizung', all);\n    return [null, null];\n}\nall[name] = msg.payload;\nflow.set('heizung', all);\nmsg.room = name;\n\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: `${name}: ${msg.payload.local_temperature} °C → ${msg.payload.current_heating_setpoint} °C, Batterie ${msg.payload.battery ?? '?'} %`\n});\n\nif (msg.payload.battery !== null && msg.payload.battery < 20) {\n    return [msg, { topic: `Batterie schwach: ${name}`, payload: msg.payload.battery }];\n}\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 100,
    "wires": [["b2m_debug_state"], ["b2m_debug_battery"]]
  },
  {
    "id": "b2m_debug_state",
    "type": "debug",
