    "type": "function",
    "name": "Soll an ESP",
    "func": "// Merken, was das Dashboard gerade zeigt (für die Sperre)\nflow.set('uiSetpoint', { payload: msg.payload, topic: msg.topic });\nif (flow.get('auto') === true) return null;   // gesperrt\nconst v = Number(msg.payload);\nif (isNaN(v)) return null;\nconst esp = flow.get('espSetpoint');\nif (esp !== undefined && Math.abs(esp - v) < 0.01) return null;   // kein Echo\nreturn { payload: String(v) };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 360
  },
