    "type": "function",
    "name": "ESP Ein/Aus",
    "func": "// true = Heizung freigegeben (so wertet die Heater logic setWindow aus)\nlet on;\nif (msg.payload === 'on') on = true;\nelse if (msg.payload === 'off') on = false;\nelse return null;\nflow.set('espEnabled', on);\nreturn { payload: on, topic: 'setWindow' };",
